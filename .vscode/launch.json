{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Trapdoor and open browser",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "redirectOutput": true,
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Running on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
